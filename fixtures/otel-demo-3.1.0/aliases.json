 "rules": [
  {
   "id": "no-ip",
   "rule": "Never alias an IP address. checkout reaches its callees as 172.18.0.x and Envoy logs upstream hosts as IPs; both change on every restart."
  },
  {
   "id": "server-span-wins",
   "rule": "Resolve a call by the service.name on the callee's server span. Use the address only when the callee emits no span."
  },
  {
   "id": "ingress-by-cluster",
   "rule": "Envoy access logs resolve by upstream.cluster; the caller is known only by user agent, so ingress edges carry low confidence until a trace confirms them."
  },
  {
   "id": "login-is-not-identity",
   "rule": "A database login shared by several services is never used for attribution (D27)."
  },
  {
   "id": "patterns-last",
   "rule": "Exact rows win over pattern rows; {value} and {group} are filled from the matched name."
  }
 ],
