# Source this file, after the demo's own .env, before docker compose up.
DEMO_VERSION=3.1.0
OTEL_COLLECTOR_CONFIG_EXTRAS=./otelcol-capture.yml   # this folder's add-on
LOCUST_BROWSER_USER_WEIGHT=0                          # HTTP users only; no headless browser
CAPTURE_DIR=./capture
HOST_FILESYSTEM=./empty-hostfs                        # instead of the host's root filesystem
DOCKER_SOCK=./no-docker.sock                          # instead of the host's Docker socket
