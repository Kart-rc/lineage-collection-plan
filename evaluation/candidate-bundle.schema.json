{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "changes": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "gate": {
            "enum": [
              "pass",
              "warn",
              "block",
              "unavailable"
            ]
          },
          "id": {
            "minLength": 1,
            "type": "string"
          },
          "readers": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "readers",
          "gate"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "commit": {
      "minLength": 1,
      "type": "string"
    },
    "fault_scenarios": {
      "additionalProperties": false,
      "properties": {
        "observations": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "count": {
                "minimum": 0,
                "type": "integer"
              },
              "name": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "name",
              "count"
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        },
        "source_run_id": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "source_run_id",
        "observations"
      ],
      "type": "object"
    },
    "graph": {
      "additionalProperties": false,
      "properties": {
        "dataset_edges": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "from": {
                "minLength": 1,
                "type": "string"
              },
              "state": {
                "minLength": 1,
                "type": "string"
              },
              "to": {
                "minLength": 1,
                "type": "string"
              },
              "type": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "from",
              "to",
              "type"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "field_edges": {
          "items": {
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "class": {
                      "const": "DIRECT"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "subtype": {
                      "enum": [
                        "IDENTITY",
                        "TRANSFORMATION",
                        "AGGREGATION"
                      ]
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "class": {
                      "const": "INDIRECT"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "subtype": {
                      "enum": [
                        "JOIN",
                        "FILTER",
                        "GROUP_BY",
                        "SORT",
                        "WINDOW",
                        "CONDITIONAL"
                      ]
                    }
                  }
                }
              }
            ],
            "properties": {
              "class": {
                "enum": [
                  "DIRECT",
                  "INDIRECT"
                ]
              },
              "condition": {
                "minLength": 1,
                "type": [
                  "string",
                  "null"
                ]
              },
              "from": {
                "minLength": 1,
                "type": "string"
              },
              "masking": {
                "type": "boolean"
              },
              "state": {
                "minLength": 1,
                "type": "string"
              },
              "subtype": {
                "enum": [
                  "IDENTITY",
                  "TRANSFORMATION",
                  "AGGREGATION",
                  "JOIN",
                  "FILTER",
                  "GROUP_BY",
                  "SORT",
                  "WINDOW",
                  "CONDITIONAL"
                ]
              },
              "to": {
                "minLength": 1,
                "type": "string"
              },
              "type": {
                "const": "DERIVES"
              }
            },
            "required": [
              "from",
              "to",
              "class",
              "subtype"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "flag_edges": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "from": {
                "minLength": 1,
                "type": "string"
              },
              "state": {
                "minLength": 1,
                "type": "string"
              },
              "to": {
                "minLength": 1,
                "type": "string"
              },
              "type": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "from",
              "to",
              "type"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "gated_field_edges": {
          "items": {
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "class": {
                      "const": "DIRECT"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "subtype": {
                      "enum": [
                        "IDENTITY",
                        "TRANSFORMATION",
                        "AGGREGATION"
                      ]
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "class": {
                      "const": "INDIRECT"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "subtype": {
                      "enum": [
                        "JOIN",
                        "FILTER",
                        "GROUP_BY",
                        "SORT",
                        "WINDOW",
                        "CONDITIONAL"
                      ]
                    }
                  }
                }
              }
            ],
            "properties": {
              "class": {
                "enum": [
                  "DIRECT",
                  "INDIRECT"
                ]
              },
              "condition": {
                "minLength": 1,
                "type": [
                  "string",
                  "null"
                ]
              },
              "from": {
                "minLength": 1,
                "type": "string"
              },
              "masking": {
                "type": "boolean"
              },
              "state": {
                "minLength": 1,
                "type": "string"
              },
              "subtype": {
                "enum": [
                  "IDENTITY",
                  "TRANSFORMATION",
                  "AGGREGATION",
                  "JOIN",
                  "FILTER",
                  "GROUP_BY",
                  "SORT",
                  "WINDOW",
                  "CONDITIONAL"
                ]
              },
              "to": {
                "minLength": 1,
                "type": "string"
              },
              "type": {
                "const": "DERIVES"
              }
            },
            "required": [
              "from",
              "to",
              "class",
              "subtype",
              "condition"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "service_edges": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "from": {
                "minLength": 1,
                "type": "string"
              },
              "state": {
                "minLength": 1,
                "type": "string"
              },
              "to": {
                "minLength": 1,
                "type": "string"
              },
              "type": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "from",
              "to",
              "type"
            ],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [],
      "type": "object"
    },
    "incidents": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "detected": {
            "type": "boolean"
          },
          "id": {
            "minLength": 1,
            "type": "string"
          },
          "minutes_to_detect": {
            "minimum": 0,
            "type": [
              "number",
              "null"
            ]
          },
          "ranking": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "id",
          "detected",
          "ranking",
          "minutes_to_detect"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "payload_scan": {
      "additionalProperties": false,
      "properties": {
        "observations": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "count": {
                "minimum": 0,
                "type": "integer"
              },
              "name": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "name",
              "count"
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        },
        "source_run_id": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "source_run_id",
        "observations"
      ],
      "type": "object"
    },
    "rebuild": {
      "additionalProperties": false,
      "properties": {
        "as_of": {
          "minLength": 1,
          "type": "string"
        },
        "live_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "replayed_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "source_run_id": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "live_sha256",
        "replayed_sha256",
        "as_of",
        "source_run_id"
      ],
      "type": "object"
    },
    "schema_version": {
      "const": 1
    },
    "slice": {
      "minimum": 1,
      "type": "integer"
    },
    "sources": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "commit": {
            "minLength": 1,
            "type": "string"
          },
          "ended_at": {
            "minLength": 1,
            "type": "string"
          },
          "event_count": {
            "minimum": 1,
            "type": "integer"
          },
          "kind": {
            "enum": [
              "recorded_twin_captures",
              "recorded_corpora",
              "fresh_twin_run",
              "one_day_of_production_evidence"
            ]
          },
          "path": {
            "minLength": 1,
            "type": "string"
          },
          "run_id": {
            "minLength": 1,
            "type": "string"
          },
          "sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "started_at": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "kind",
          "path",
          "sha256",
          "run_id",
          "commit",
          "started_at",
          "ended_at",
          "event_count"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "timings": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "requirement": {
            "enum": [
              "IA-1",
              "IN-10",
              "IR-1",
              "XC-7"
            ]
          },
          "samples_seconds": {
            "items": {
              "minimum": 0,
              "type": "number"
            },
            "minItems": 1,
            "type": "array"
          },
          "source_run_id": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "requirement",
          "source_run_id",
          "samples_seconds"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "work_packages": {
      "items": {
        "pattern": "^WP-[0-9]{2}$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "commit",
    "work_packages"
  ],
  "type": "object"
}
